{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bwb-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat is required by both Next.js/OpenNext and the Prisma D1 adapter.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bwb-crm-db",
      // Replace after running: wrangler d1 create bwb-crm-db
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
