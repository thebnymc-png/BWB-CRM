{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bwbcrm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat is required by both Next.js/OpenNext and the Prisma D1 adapter.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bwb-crm-db",
      "database_id": "40229ab6-5b35-404e-abc2-f6b1aaa1d452"
    }
  ]
}
